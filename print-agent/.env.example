# ---- Restaurant Print Agent config ----
# Copy this file to ".env" and fill in the values.

# Base URL of your DEPLOYED app (the same one your phones open).
# Example: https://your-restaurant.vercel.app  (no trailing slash)
APP_BASE_URL=https://your-app.vercel.app

# How to reach the printer:
#   raw    = send to a Windows printer queue (RAW spooler). Use this when the printer
#            is installed as a Windows printer/driver (e.g. "POS80 Printer" on USB001).
#   serial = write directly to a COM port (only if the printer exposes one).
PRINT_MODE=raw

# RAW mode: the exact Windows printer name (see: Get-Printer, or Control Panel > Devices).
WINDOWS_PRINTER_NAME=POS80 Printer

# SERIAL mode only: the COM port. Leave blank to auto-detect.
# Find it with:  npm run list-ports   (e.g. COM3)
SERIAL_PATH=

# SERIAL mode only: baud rate. Must match the printer.
BAUD_RATE=9600

# How often (ms) to poll the server for new print jobs.
POLL_MS=1500

# How often (ms) to send an "I'm alive" heartbeat so Admin shows the station online.
HEARTBEAT_MS=6000

# Paper width: 80mm or 58mm (only used as a fallback if a job doesn't specify one).
PAPER_WIDTH=80mm

# Print a small "TEST OK" receipt every time the agent starts (true/false).
TEST_PRINT_ON_START=true

# Optional shared secret. If your app's print endpoints later require it,
# it is sent as the "x-print-agent-key" header. Safe to leave blank for now.
PRINT_AGENT_KEY=
